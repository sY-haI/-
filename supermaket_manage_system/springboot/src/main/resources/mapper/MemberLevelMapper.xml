<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.MemberLevelMapper">

    <!-- 根据积分查询会员等级 -->
    <select id="selectByPoints" resultType="com.example.entity.MemberLevel">
        select * from `member_level`
        where min_points &lt;= #{points}
        order by min_points desc
            limit 1
    </select>

    <!-- 查询所有等级 -->
    <select id="selectAll" resultType="com.example.entity.MemberLevel">
        select * from `member_level`
        order by min_points asc
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" resultType="com.example.entity.MemberLevel">
        select * from `member_level` where id = #{id}
    </select>

</mapper>